async def refresh_account(sess: aiohttp.ClientSession, acct: Account,
                          notify: bool = True) -> bool:
    """Refresh one account once for all overlapping in-process waiters.

    The async lock coalesces tasks and the file lock extends the same generation
    boundary across processes. A waiter re-checks the durable generation after
    acquiring both locks and reuses a peer's completed rotation.
    """
    requested_token = acct.refresh_token
    async with acct.async_lock():
        ensure_dirs()
        lockpath = LOCKS / (acct.key + ".lock")
        lf = open(lockpath, "a")
        try:
            await asyncio.get_event_loop().run_in_executor(
                None, fcntl.flock, lf.fileno(), fcntl.LOCK_EX
            )
            fresh = None
            with contextlib.suppress(Exception):
                fresh = json.loads((ACCTS / (acct.key + ".json")).read_text())
            if fresh:
                tok = fresh.get("tokens") or {}
                durable_token = tok.get("refresh_token") or ""
                acct.account_id = tok.get("account_id") or acct.account_id
                acct.access_token = tok.get("access_token") or acct.access_token
                acct.refresh_token = durable_token or acct.refresh_token
                acct.id_token = tok.get("id_token") or acct.id_token
                acct.last_refresh = str(fresh.get("last_refresh") or acct.last_refresh)
                meta = fresh.get("cxp") or {}
                acct.usage_5h = optional_int(meta.get("usage_5h"))
                acct.usage_week = optional_int(meta.get("usage_week"))
                state = str(meta.get("state") or "unknown")
                acct.state = state if state in ACCOUNT_STATES else "unknown"
                acct.usage_at = optional_float(meta.get("usage_at"))
                acct.walled_until = optional_float(meta.get("walled_until"))
                acct.reauth_cooldown_until = optional_float(meta.get("reauth_cooldown_until"))
                acct._baseline_doc = json.loads(json.dumps(fresh))
                if requested_token and durable_token and durable_token != requested_token:
                    log("refresh %s coalesced" % acct.email)
                    return True

            body = {"client_id": CLIENT_ID, "grant_type": "refresh_token",
                    "refresh_token": acct.refresh_token}
            try:
                async with sess.post(REFRESH_URL, json=body,
                                     headers={"Content-Type": "application/json",
                                              "Accept-Encoding": "identity"},
                                     timeout=aiohttp.ClientTimeout(total=30)) as r:
                    if r.status != 200:
                        # OAuth bodies are untrusted and may echo credentials.
                        log("refresh %s FAILED %d" % (acct.email, r.status))
                        if r.status in (400, 401):
                            await mark_account_needs_reauth(acct, lock_held=True)
                            audit_auth_event("refresh_needs_reauth",
                                             account=account_hint(acct),
                                             account_id=acct.account_id,
                                             status=r.status)
                            if notify:
                                notify_reauth_needed([acct])
                        return False
                    data = await r.json()
            except Exception as e:
                log("refresh %s error %s" % (acct.email, e))
                return False
            acct.access_token = data.get("access_token") or acct.access_token
            if data.get("refresh_token"):
                acct.refresh_token = data["refresh_token"]
            if data.get("id_token"):
                acct.id_token = data["id_token"]
            acct.last_refresh = utc_now()
            acct.persist(lock_held=True, replace_credentials=True)
            log("refresh %s OK" % acct.email)
            return True
        finally:
            with contextlib.suppress(Exception):
                fcntl.flock(lf.fileno(), fcntl.LOCK_UN)
            lf.close()


async def probe_usage(sess: aiohttp.ClientSession, acct: Account,
                      allow_refresh: bool = True,
                      max_age: float = USAGE_TTL,
                      notify: bool = True) -> None:
    """Refresh acct.state/usage from live wham/usage."""
    if acct.state == "walled" and acct.walled_until and time.time() >= acct.walled_until:
        acct.state = "unknown"
        await persist_account_async(acct)
    if max_age > 0 and time.time() - acct.usage_at < max_age and acct.state != "unknown":
        return
    # burned/dead account: only cxp login can replace this credential — but a
    # login or out-of-band probe may already have done exactly that on disk.
    # Adopt the recovered generation instead of staying burned in memory until
    # the next proxy restart (2026-08-15: the proxy 429'd every request for
    # hours while the account files held healthy, re-logged credentials).
    if acct.state == "needs_reauth":
        fresh = None
        with contextlib.suppress(Exception):
            fresh = json.loads((ACCTS / (acct.key + ".json")).read_text())
        disk_state = str(((fresh or {}).get("cxp") or {}).get("state") or "")
        if fresh and disk_state in ACCOUNT_STATES and disk_state != "needs_reauth":
            tok = fresh.get("tokens") or {}
            acct.account_id = tok.get("account_id") or acct.account_id
            acct.access_token = tok.get("access_token") or acct.access_token
            acct.refresh_token = tok.get("refresh_token") or acct.refresh_token
            acct.id_token = tok.get("id_token") or acct.id_token
            acct.last_refresh = str(fresh.get("last_refresh") or acct.last_refresh)
            meta = fresh.get("cxp") or {}
            acct.usage_5h = optional_int(meta.get("usage_5h"))
            acct.usage_week = optional_int(meta.get("usage_week"))
            acct.state = disk_state
            acct.usage_at = optional_float(meta.get("usage_at"))
            acct.walled_until = optional_float(meta.get("walled_until"))
            acct.reauth_cooldown_until = optional_float(
                meta.get("reauth_cooldown_until"))
            acct._baseline_doc = json.loads(json.dumps(fresh))
            log("reauth-recovery: adopted disk credential for %s (state=%s)"
                % (acct.email, disk_state))
        if acct.state == "needs_reauth":
            return
    headers = {"Authorization": "Bearer " + acct.access_token,
               "ChatGPT-Account-Id": acct.account_id,
               "Accept": "application/json", "User-Agent": "cxp/0.1",
               # Upstream serves brotli when offered; this aiohttp env cannot
               # decode br (2026-09-04: every probe died 400 "Can not decode
               # content-encoding: br", pinning the account to state=unknown).
               "Accept-Encoding": "identity"}
    try:
        async with sess.get(WHAM_USAGE_URL, headers=headers,
                            timeout=aiohttp.ClientTimeout(total=15)) as r:
            status = r.status
            data = await r.json() if r.content_type == "application/json" else {}
    except Exception as e:
        log("usage %s error %s" % (acct.email, e))
        return
    if status == 401:
        if allow_refresh and await refresh_account(sess, acct, notify=notify):
            return await probe_usage(sess, acct, allow_refresh=False, max_age=0,
                                     notify=notify)
        if acct.state != "needs_reauth":
            if allow_refresh:
                log("usage %s got 401 but refresh did not confirm reauth" % acct.email)
            else:
                await mark_account_needs_reauth(acct)
        if acct.state == "needs_reauth":
            audit_auth_event("usage_probe_needs_reauth",
                             account=account_hint(acct),
                             account_id=acct.account_id,
                             status=status)
            if notify:
                notify_reauth_needed([acct])
        return
    rate = (data or {}).get("rate_limit") or {}
    p = rate.get("primary_window") or {}
    s = rate.get("secondary_window") or {}
    acct.usage_5h = p.get("used_percent")
    acct.usage_week = s.get("used_percent")
    acct.usage_at = time.time()
    if rate.get("allowed"):
        acct.state = "allowed"
        acct.walled_until = 0.0
    elif rate.get("limit_reached"):
        acct.state = "walled"
        # remember the soonest reset so we re-probe after it
        resets = [w.get("reset_at") for w in (p, s) if w.get("used_percent") == 100]
        acct.walled_until = min([x for x in resets if x] or [time.time() + 300])
    else:
        acct.state = "unknown"
    await persist_account_async(acct)


