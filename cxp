# Bound the time-to-response-headers on an upstream forward. chatgpt.com can
# accept a codex request and sit on it for minutes under load; without this
# bound the client-side (OMP) stream watchdog aborts at 120s with a generic
# "Request was aborted" while a fresh attempt on a sibling account succeeds in
# seconds. On expiry we return None so handle() rotates accounts (no wall
# marking — a stall is not a quota signal). Body streaming is NOT affected;
# this only covers the pre-header phase.
UPSTREAM_HEADER_TIMEOUT_SECONDS = max(10, env_int("CXP_UPSTREAM_HEADER_TIMEOUT_SECONDS", 60))
QUOTA_ERROR_TYPES = {"response.failed", "error", "response.error"}
